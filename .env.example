# Copy to .env (root, for Compose) and apps/api/.env (for Prisma and the API).
# Local development values only.
POSTGRES_USER=permitgraph
POSTGRES_PASSWORD=permitgraph
POSTGRES_DB=permitgraph
POSTGRES_PORT=5432

DATABASE_URL=postgresql://permitgraph:permitgraph@127.0.0.1:5432/permitgraph?schema=public
PORT=3001
HOST=127.0.0.1

# apps/web/.env.local: where the web UI finds the API, and the seeded user it
# acts as (there is no sign-in yet).
PERMITGRAPH_API_URL=http://127.0.0.1:3001
PERMITGRAPH_USER=u-vera
