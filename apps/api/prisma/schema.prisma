// PermitGraph API schema. Every graph table added later hangs off a
// workspace, so data from one workspace is never visible from another.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  displayName String            @map("display_name")
  createdAt   DateTime          @default(now()) @map("created_at")
  memberships WorkspaceMember[]
  snapshots   Snapshot[]

  @@map("users")
}

model Workspace {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  createdAt DateTime          @default(now()) @map("created_at")
  members   WorkspaceMember[]
  snapshots Snapshot[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// An imported graph snapshot. Rows are never updated (a database trigger
/// rejects UPDATE); a new import always creates a new snapshot.
model Snapshot {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  label           String
  contentHash     String    @map("content_hash")
  graph           Json
  principalCount  Int       @map("principal_count")
  groupCount      Int       @map("group_count")
  membershipCount Int       @map("membership_count")
  resourceCount   Int       @map("resource_count")
  grantCount      Int       @default(0) @map("grant_count")
  importedById    String    @map("imported_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importedBy      User      @relation(fields: [importedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, contentHash])
  @@map("snapshots")
}
